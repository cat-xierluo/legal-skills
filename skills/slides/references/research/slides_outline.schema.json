{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SlidesOutline",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["page_title", "summary", "layout_type"],
    "properties": {
      "page_title": {
        "type": "string",
        "minLength": 1
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "layout_type": {
        "type": "string",
        "enum": ["title", "two_column", "full_width"]
      },
      "key_points": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "speaker_notes": {
        "type": "string"
      }
    },
    "additionalProperties": true
  }
}
