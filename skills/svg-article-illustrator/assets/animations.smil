<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 200" role="img" aria-labelledby="motion-title">
<title id="motion-title">独立定位层与运动层</title>
<rect width="300" height="200" fill="#eef3f7"/>
<g transform="translate(150 110)">
  <g>
    <g>
      <circle r="30" fill="#17609a"/>
      <animateTransform attributeName="transform" type="scale" values="1;1.1;1" keyTimes="0;0.5;1" begin="0s" dur="3s" repeatCount="indefinite" fill="freeze"/>
    </g>
    <animateTransform attributeName="transform" type="translate" values="0 0;0 -12;0 0" keyTimes="0;0.5;1" begin="0s" dur="3s" repeatCount="indefinite" fill="freeze"/>
  </g>
</g>
</svg>
