    {
      "id": "missing-init-environment",
      "kind": "mutation",
      "constraint_ids": [
        "INIT-ENVIRONMENT-RECORD-ON-WRITE"
      ],
      "checker_ids": [
        "legal-baseline-checker"
      ],
      "artifacts": [
