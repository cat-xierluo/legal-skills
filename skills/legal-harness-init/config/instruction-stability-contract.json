{
  "schema_version": 1,
  "skill": {
    "name": "legal-harness-init",
    "version": "0.5.3"
  },
  "producer": {
    "id": "legal-harness-init-workflow",
    "implementation_paths": [
      "SKILL.md",
      "scripts/detect.sh",
      "scripts/validate-content.sh",
      "scripts/write.sh",
      "scripts/verify.sh",
      "scripts/record-init-env.sh",
      "scripts/probe-session-model.sh",
      "scripts/check-baseline.py",
      "scripts/test.sh",
      "scripts/lib_safety.sh",
      "scripts/lib_platforms.sh",
      "scripts/session-model.py"
    ]
  },
  "artifacts": [
    {
      "id": "delivery-report",
      "stage": "final",
      "required": true
    },
    {
      "id": "configuration",
      "stage": "final",
      "required": true
    }
  ],
  "checkers": [
    {
      "id": "legal-baseline-checker",
      "kind": "active",
      "modality": "schema",
      "artifact_stages": [
        "final"
      ],
      "independent_from_producer": true,
      "runtime": "python3",
      "implementation": "scripts/check-baseline.py",
      "args": [
        "--input",
        "{artifact:delivery-report}",
        "--config",
        "{artifact:configuration}"
      ],
      "timeout_seconds": 30
    }
  ],
  "constraints": [
    {
      "id": "PRIVACY-MINIMUM-CONTEXT",
      "severity": "hard",
      "requirement_type": "schema",
      "stage": "final",
      "source_refs": [
        "SKILL.md#PRIVACY-MINIMUM-CONTEXT"
      ],
      "checker_ids": [
        "legal-baseline-checker"
      ],
      "case_ids": [
        "baseline-complete",
        "sensitive-case-leak"
      ],
      "historical_failure_known": false
    },
    {
      "id": "MANAGED-BLOCK-SAFE-UPSERT",
      "severity": "hard",
      "requirement_type": "schema",
      "stage": "final",
      "source_refs": [
        "SKILL.md#MANAGED-BLOCK-SAFE-UPSERT"
      ],
      "checker_ids": [
        "legal-baseline-checker"
      ],
      "case_ids": [
        "baseline-complete",
        "duplicate-managed-marker"
      ],
      "historical_failure_known": false
    },
    {
      "id": "COMPLETION-STATUS-NO-OVERCLAIM",
      "severity": "hard",
      "requirement_type": "schema",
      "stage": "final",
      "source_refs": [
        "SKILL.md#COMPLETION-STATUS-NO-OVERCLAIM"
      ],
      "checker_ids": [
        "legal-baseline-checker"
      ],
      "case_ids": [
        "baseline-complete",
        "behavior-status-without-evidence"
      ],
      "historical_failure_known": false
    },
    {
      "id": "TEAM-LAYER-PRECEDENCE",
      "severity": "hard",
      "requirement_type": "schema",
      "stage": "final",
      "source_refs": [
        "SKILL.md#TEAM-LAYER-PRECEDENCE"
      ],
      "checker_ids": [
        "legal-baseline-checker"
      ],
      "case_ids": [
        "baseline-complete",
        "team-precedence-reversed"
      ],
      "historical_failure_known": false
    },
    {
      "id": "INIT-ENVIRONMENT-RECORD-ON-WRITE",
      "severity": "hard",
      "requirement_type": "schema",
      "stage": "final",
      "source_refs": [
        "SKILL.md#INIT-ENVIRONMENT-RECORD-ON-WRITE"
      ],
      "checker_ids": [
        "legal-baseline-checker"
      ],
      "case_ids": [
        "baseline-complete",
        "missing-init-environment",
        "historical-missing-init-environment"
      ],
      "historical_failure_known": true
    }
  ],
  "cases": [
    {
      "id": "baseline-complete",
      "kind": "positive",
      "constraint_ids": [
        "PRIVACY-MINIMUM-CONTEXT",
        "MANAGED-BLOCK-SAFE-UPSERT",
        "COMPLETION-STATUS-NO-OVERCLAIM",
        "TEAM-LAYER-PRECEDENCE",
        "INIT-ENVIRONMENT-RECORD-ON-WRITE"
      ],
      "checker_ids": [
        "legal-baseline-checker"
      ],
      "artifacts": [
        {
          "artifact_id": "delivery-report",
          "path": "assets/stability-complete.json"
        },
        {
          "artifact_id": "configuration",
          "path": "assets/stability-complete/AGENTS.md"
        }
      ],
      "expected": "pass",
      "expected_exit_code": 0
    },
    {
      "id": "sensitive-case-leak",
      "kind": "mutation",
      "constraint_ids": [
        "PRIVACY-MINIMUM-CONTEXT"
      ],
      "checker_ids": [
