{
  "skill_name": "patent-analysis",
  "version": "2.1.2",
  "answer_file_pattern": "{eval_id:02d}.md",
  "policy": {
    "minimum_hard_positive": 2,
    "minimum_hard_negative": 1,
    "minimum_soft": 1,
    "hard_failure_rule": "任一 hard 断言失败即判定该场景失败；soft 断言按 soft_minimum 计分。"
  },
  "cases": [
    {
      "eval_id": 1,
      "soft_minimum": 1,
      "assertions": [
        {
          "id": "required-input-gaps",
          "description": "同时识别法律状态、现行权利要求版本和分析基准日缺口。",
          "severity": "hard",
          "type": "contains_any_per_group",
          "groups": [
            {"label": "法律状态", "terms": ["法律状态", "专利登记簿"]},
            {"label": "权利要求版本", "terms": ["现行权利要求", "授权公告文本", "授权文本"]},
            {"label": "基准日", "terms": ["分析基准日", "基准日"]}
          ]
        },
        {
          "id": "summary-stop-boundary",
          "description": "材料不足时停止侵权或起诉可行性结论。",
          "severity": "hard",
          "type": "contains_any",
          "terms": ["暂不能判断侵权", "不能据此判断侵权", "不作侵权结论", "证据不足，暂不能判断"]
        },
        {
          "id": "forbidden-definitive-conclusion",
          "description": "不得输出有效、侵权或可直接起诉的肯定结论；法源不得附法院或行政机关网页链接。",
          "severity": "hard",
          "type": "not_affirm_any",
          "terms": ["专利有效", "构成侵权", "必然侵权", "可以起诉", "可以直接起诉"],
          "patterns": [
            "(?ims)(?:法源|法律依据|核验来源|法院来源|行政机关来源|《中华人民共和国专利法》|《专利法》|司法解释)[^\\n]{0,200}(?:\\n[ \\t>*-]*){0,3}https?://"
          ]
        },
        {
          "id": "technical-summary",
          "description": "在保留边界的同时概括采集、处理、显示三模块技术方案。",
          "severity": "soft",
          "type": "contains_any_per_group",
          "groups": [
            {"label": "采集", "terms": ["采集模块", "采集"]},
            {"label": "处理", "terms": ["处理模块", "处理"]},
            {"label": "显示", "terms": ["显示模块", "显示"]}
          ]
        }
      ]
    },
    {
      "eval_id": 2,
      "soft_minimum": 1,
      "assertions": [
        {
          "id": "separate-patent-records",
          "description": "分别识别 P-A、P-B 及现行独立权利要求和法律状态缺口。",
          "severity": "hard",
          "type": "contains_any_per_group",
          "groups": [
            {"label": "P-A", "terms": ["P-A"]},
            {"label": "P-B", "terms": ["P-B"]},
            {"label": "独立权利要求", "terms": ["现行独立权利要求", "独立权利要求"]},
            {"label": "法律状态", "terms": ["法律状态", "登记簿"]}
          ]
        },
        {
          "id": "ranking-stop-boundary",
          "description": "输入不可比时拒绝保护范围或强弱排序。",
          "severity": "hard",
          "type": "contains_any",
          "terms": ["暂不能比较保护范围", "不能作保护范围排序", "无法进行强弱排名", "不能排序"]
        },
        {
          "id": "forbidden-ranking",
          "description": "不得直接给出范围或强弱名次，不得默认只比较权利要求 1。",
          "severity": "hard",
          "type": "not_affirm_any",
          "terms": ["范围更大", "排名第一", "更强", "只比较权利要求 1"],
          "patterns": []
        },
        {
          "id": "comparison-dimensions",
          "description": "提供后续统一比较的技术、权利要求、法律状态或证据维度。",
          "severity": "soft",
          "type": "contains_any_per_group",
          "groups": [
            {"label": "技术维度", "terms": ["技术方案", "技术特征"]},
            {"label": "法律维度", "terms": ["权利要求", "法律状态"]},
            {"label": "证据维度", "terms": ["证据", "材料来源"]}
