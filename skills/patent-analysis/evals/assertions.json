            {"label": "可联想到性", "terms": ["无需创造性劳动", "本领域普通技术人员"]},
            {"label": "说明书捐献", "terms": ["说明书捐献", "说明书是否披露但权利要求未记载"]},
            {"label": "禁止反悔", "terms": ["禁止反悔", "修改或陈述放弃"]},
            {"label": "特别限定", "terms": ["功能性特征", "数值特征", "特别限定"]}
          ]
        },
        {
          "id": "multi-provision-basis",
          "description": "全面覆盖和等同结论列出共同适用的多条款法源。",
          "severity": "hard",
          "type": "contains_any_per_group",
          "groups": [
            {"label": "保护范围", "terms": ["《专利法》第六十四条", "《中华人民共和国专利法》第六十四条"]},
            {"label": "全面覆盖", "terms": ["《专利侵权司法解释（一）》第七条", "《最高人民法院关于审理侵犯专利权纠纷案件应用法律若干问题的解释》第七条"]},
            {"label": "等同一般定义", "terms": ["《专利纠纷若干规定》第十三条", "《最高人民法院关于审理专利纠纷案件适用法律问题的若干规定》第十三条"]}
          ]
