        {
          "id": "literal-and-equivalent-gates",
          "description": "C 阻断字面全面覆盖，B 不计入覆盖，等同仅逐特征判断。",
          "severity": "hard",
          "type": "contains_any_per_group",
          "groups": [
            {"label": "字面覆盖阻断", "terms": ["不满足字面全面覆盖", "字面全面覆盖不成立", "不支持字面全面覆盖", "C 阻断"]},
            {"label": "B 证据门禁", "terms": ["不得计入已覆盖", "不能计入已覆盖"]},
            {"label": "逐特征等同", "terms": ["逐特征判断", "仅针对 F2-2", "对应技术特征"]}
          ]
