<?xml version="1.0" encoding="UTF-8"?>
<!--
  模板：多主体关系图（multi-party-relation）
  适用场景：L-01 签订主体与履行主体不一致；L-02 多合同与关联主体借款
  必要输入字段：entities[].visual_role / epistemic_status，relations[].status
  默认布局：权利基础纵轴 + 名义主体 / 实际主体 / 资金落点三列
  几何约束：模板坐标锁定；视觉角色编译器只允许改 style 与视觉元数据
-->
<mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageScale="1">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="page" value=""
      style="rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D8E0E8;strokeWidth=1;container=1;shadow=0;"
      vertex="1" parent="1">
      <mxGeometry x="20" y="10" width="980" height="540" as="geometry"/>
    </mxCell>
    <mxCell id="title" value="多主体借款关系图"
      style="text;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#172033;"
      vertex="1" parent="1">
      <mxGeometry x="70" y="28" width="880" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="subtitle" value="将合同权利基础、名义签约、实际用款与资金落点分层呈现"
      style="text;fontSize=13;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#64748B;"
      vertex="1" parent="1">
      <mxGeometry x="70" y="72" width="880" height="24" as="geometry"/>
    </mxCell>
    <mxCell id="lender" value="贷款人&#xa;（原告）"
      visualRole="plaintiff" epistemicStatus="confirmed" visualEmphasis="high" visualTheme="client_report"
      style="rounded=1;arcSize=10;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FB;strokeColor=#246FA8;strokeWidth=3;fontSize=14;fontStyle=1;fontColor=#172033;"
      vertex="1" parent="1">
      <mxGeometry x="410" y="110" width="200" height="68" as="geometry"/>
    </mxCell>
    <mxCell id="contract" value="借款合同&#xa;待填：日期 / 金额"
      visualRole="contract" epistemicStatus="confirmed" visualEmphasis="normal" visualTheme="client_report"
      style="rounded=1;arcSize=10;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF9E8;strokeColor=#B88917;strokeWidth=2;fontSize=14;fontStyle=0;fontColor=#332A12;"
      vertex="1" parent="1">
      <mxGeometry x="410" y="225" width="200" height="68" as="geometry"/>
    </mxCell>
    <mxCell id="nominal-label" value="名义签约主体"
      style="text;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#52677D;"
      vertex="1" parent="1">
      <mxGeometry x="50" y="335" width="200" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="actual-label" value="实际履行主体"
      style="text;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#D97706;"
      vertex="1" parent="1">
      <mxGeometry x="410" y="335" width="200" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="account-label" value="资金落点"
      style="text;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#64748B;"
      vertex="1" parent="1">
      <mxGeometry x="770" y="335" width="200" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="nominal" value="名义借款人&#xa;（被告）"
      visualRole="defendant" epistemicStatus="confirmed" visualEmphasis="normal" visualTheme="client_report"
      style="rounded=1;arcSize=10;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FB;strokeColor=#246FA8;strokeWidth=2;fontSize=14;fontStyle=0;fontColor=#172033;"
      vertex="1" parent="1">
      <mxGeometry x="50" y="380" width="200" height="68" as="geometry"/>
    </mxCell>
    <mxCell id="actual" value="实际用款人&#xa;（第三人 / 推定）"
      visualRole="third_party" epistemicStatus="inferred" visualEmphasis="normal" visualTheme="client_report"
      style="rounded=1;arcSize=10;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF2DE;strokeColor=#9E9E9E;strokeWidth=2;fontSize=14;fontStyle=0;fontColor=#3F2A0A;dashed=1;dashPattern=1 4;"
      vertex="1" parent="1">
      <mxGeometry x="410" y="380" width="200" height="68" as="geometry"/>
    </mxCell>
    <mxCell id="account" value="收款账户&#xa;待补：开户行"
      visualRole="amount" epistemicStatus="missing" visualEmphasis="low" visualTheme="client_report"
      style="rounded=1;arcSize=10;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF1DF;strokeColor=#9E9E9E;strokeWidth=1;fontSize=14;fontStyle=0;fontColor=#616161;dashed=1;"
      vertex="1" parent="1">
      <mxGeometry x="770" y="380" width="200" height="68" as="geometry"/>
    </mxCell>
    <mxCell id="e1" value="合同关系"
      relationStatus="confirmed" visualTheme="client_report"
      style="endArrow=classic;strokeWidth=2;strokeColor=#333333;dashed=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;"
      edge="1" source="contract" target="lender" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e2" value="实际用款（推定）"
      relationStatus="inferred" visualTheme="client_report"
      style="endArrow=classic;strokeWidth=2;strokeColor=#9E9E9E;dashed=1;dashPattern=1 4;exitX=0;exitY=0.5;entryX=1;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;fontColor=#64748B;labelBackgroundColor=#FFFFFF;"
      edge="1" source="actual" target="nominal" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e3" value="资金流向（待补）"
      relationStatus="missing" visualTheme="client_report"
      style="endArrow=classic;strokeWidth=2;strokeColor=#9E9E9E;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;fontColor=#64748B;labelBackgroundColor=#FFFFFF;"
      edge="1" source="actual" target="account" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e4" value="签署（已证）"
      relationStatus="confirmed" visualTheme="client_report"
      style="endArrow=classic;strokeWidth=2;strokeColor=#333333;dashed=0;exitX=0.5;exitY=0;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;"
      edge="1" source="nominal" target="contract" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="legend" value="图例：实线 = 已证　·　点虚线 = 推定　·　灰虚线 = 待补　·　颜色表示语义类别"
      style="text;fontSize=11;align=center;verticalAlign=middle;fillColor=#F8FAFC;strokeColor=#E2E8F0;rounded=1;arcSize=8;fontColor=#64748B;spacing=4;"
      vertex="1" parent="1">
      <mxGeometry x="110" y="495" width="800" height="28" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
