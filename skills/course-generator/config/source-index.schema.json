{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cat-xierluo/legal-skills/course-generator/source-index.schema.json",
  "title": "Course Generator Source Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "blocks"],
        "properties": {
          "id": {"type": "string", "pattern": "^SRC-[0-9]{3,}$"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "source_ref", "kind", "char_count", "sha256", "preview"],
              "properties": {
                "id": {"type": "string", "pattern": "^BLK-[0-9]{5,}$"},
                "source_ref": {"type": "string", "pattern": "^SRC-[0-9]{3,}#L[0-9]{4,}-L[0-9]{4,}$"},
                "kind": {"enum": ["content", "derived", "heading", "image", "timestamp", "speaker", "separator"]},
                "char_count": {"type": "integer", "minimum": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "preview": {"type": "string", "minLength": 1, "maxLength": 160}
              }
            }
          }
        }
      }
    }
  }
}
