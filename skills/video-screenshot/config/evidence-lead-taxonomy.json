{
  "schema_version": "1.0",
  "categories": [
    {
      "id": "identity_qualification",
      "label": "主体、账号与资质",
      "anchors": ["营业执照", "统一社会信用代码", "法定代表人", "经营范围", "账号", "用户名", "小红书号", "抖音号", "主页", "店铺", "企业认证", "身份认证", "所在地", "地址"],
      "patterns": ["[0-9A-Z]{18}"],
      "minimum_anchor_hits": 2
    },
    {
      "id": "product_work_service",
      "label": "商品、作品与服务",
      "anchors": ["商品", "产品", "作品", "原创", "品牌", "型号", "规格", "详情", "价格", "立即购买", "加入购物车", "服务"],
      "patterns": ["[￥¥]\\s*\\d+(?:[.,]\\d+)?", "\\d+(?:[.,]\\d+)?\\s*元"],
      "minimum_anchor_hits": 2
    },
    {
      "id": "transaction_performance",
      "label": "交易、支付与履行",
      "anchors": ["订单", "支付", "付款", "收款", "退款", "退货", "发货", "签收", "物流", "运费", "购买", "已售", "销量", "成交", "售后", "赔付", "发票"],
      "patterns": ["订单号", "交易号", "[￥¥]\\s*\\d+(?:[.,]\\d+)?"],
      "minimum_anchor_hits": 2
    },
    {
      "id": "communication_commitment",
      "label": "沟通、通知与承诺",
      "anchors": ["聊天记录", "对话记录", "私信", "消息记录", "承诺", "保证", "同意", "确认", "通知", "催告", "拒绝", "协商记录", "客服沟通", "联系方式", "电话", "邮箱"],
      "patterns": ["\\d{2}:\\d{2}", "\\d{4}[-/.年]\\d{1,2}[-/.月]\\d{1,2}"],
      "minimum_anchor_hits": 2
    },
    {
      "id": "publicity_representation",
      "label": "宣传、描述与公开陈述",
      "anchors": ["发布", "笔记", "直播", "广告", "宣传", "介绍", "原创", "正品", "功效", "材质", "承诺", "招聘", "薪资", "包邮", "限量"],
      "patterns": ["#.{2,12}#"],
      "minimum_anchor_hits": 2
    },
    {
      "id": "review_feedback_dispute",
      "label": "评论、反馈与争议",
      "anchors": ["评论", "评价", "留言", "投诉", "举报", "差评", "反馈", "回复", "删除", "侵权", "假货", "质量问题", "不喜欢"],
      "patterns": ["评论\\s*\\d+", "评价\\s*\\d+", "留言\\s*\\d+"],
      "minimum_anchor_hits": 2
    },
    {
      "id": "reach_metric_timeline",
      "label": "传播数据与时间线",
      "anchors": ["点赞", "收藏", "转发", "分享", "浏览", "观看", "粉丝", "关注", "获赞", "销量", "已售", "发布时间", "今天", "昨天"],
      "patterns": ["\\d+\\s*(?:点赞|收藏|评论|转发|浏览|观看|粉丝|获赞|已售)"],
      "minimum_anchor_hits": 2
    },
    {
      "id": "document_record",
      "label": "文书、凭证与记录",
      "anchors": ["合同", "协议", "授权书", "声明", "通知书", "证明", "证书", "许可证", "登记", "凭证", "清单", "记录", "截图", "公证"],
      "patterns": ["编号[:：]?[0-9A-Z-]{4,}"],
      "minimum_anchor_hits": 2
    }
  ]
}
