      "id": "EVAL-REPORT-COVERAGE",
      "severity": "hard",
      "requirement_type": "coverage",
      "stage": "final",
      "source_refs": [
        "SKILL.md#EVAL-REPORT-COVERAGE"
      ],
      "checker_ids": [
        "evaluation-package-gate"
      ],
      "case_ids": [
        "evaluation-valid",
        "evaluation-legal-near-miss",
        "evaluation-missing-dimension",
        "historical-template-omission"
      ],
      "historical_failure_known": true
