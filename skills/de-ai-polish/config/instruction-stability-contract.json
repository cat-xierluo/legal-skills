    },
    {
      "id": "protected-span-mutated-mutation",
      "kind": "mutation",
      "constraint_ids": [
        "PROTECTED-SPANS-PRESERVED"
      ],
      "checker_ids": [
        "de-ai-delivery-gate"
      ],
      "artifacts": [
        {
          "artifact_id": "source-markdown",
          "path": "assets/stability/delivery-source.md"
        },
        {
          "artifact_id": "final-markdown",
          "path": "assets/stability/delivery-final-span-mutated.md"
        },
        {
          "artifact_id": "run-plan",
          "path": "assets/stability/delivery-run-plan.json"
        },
        {
          "artifact_id": "score-receipt",
          "path": "assets/stability/delivery-score-span-mutated.json"
        }
      ],
      "expected": "blocked",
      "expected_exit_code": 3
    },
    {
      "id": "protected-span-mutated",
      "kind": "historical",
      "constraint_ids": [
        "PROTECTED-SPANS-PRESERVED"
      ],
      "checker_ids": [
