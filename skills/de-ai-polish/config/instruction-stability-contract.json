{
  "schema_version": 1,
  "skill": {
    "name": "de-ai-polish",
    "version": "2.2.0"
  },
  "producer": {
    "id": "de-ai-polish-workflow",
    "implementation_paths": [
      "SKILL.md",
      "scripts/fix_punctuation.py",
      "scripts/delivery_gate.py",
      "config/quality-score-rubric.json"
    ]
  },
  "artifacts": [
    {
      "id": "source-markdown",
      "stage": "source",
      "required": true
    },
    {
      "id": "final-markdown",
      "stage": "final",
      "required": true
    },
    {
      "id": "run-plan",
      "stage": "source",
      "required": false
    },
    {
      "id": "score-receipt",
      "stage": "final",
      "required": false
    }
  ],
  "checkers": [
    {
      "id": "protected-markdown-gate",
      "kind": "active",
      "modality": "text",
      "artifact_stages": [
        "source",
        "final"
      ],
      "independent_from_producer": true,
      "runtime": "python3",
      "implementation": "scripts/protected_markdown_gate.py",
      "args": [
        "check",
        "--source",
        "{artifact:source-markdown}",
        "--final",
        "{artifact:final-markdown}"
      ],
      "timeout_seconds": 30
    },
    {
      "id": "de-ai-delivery-gate",
      "kind": "active",
      "modality": "schema",
      "artifact_stages": [
        "source",
        "final"
      ],
      "independent_from_producer": true,
      "runtime": "python3",
      "implementation": "scripts/delivery_gate.py",
      "args": [
        "check",
        "--source",
        "{artifact:source-markdown}",
        "--final",
        "{artifact:final-markdown}",
        "--run-plan",
        "{artifact:run-plan}",
        "--score-receipt",
        "{artifact:score-receipt}"
      ],
      "timeout_seconds": 30
    }
  ],
  "constraints": [
    {
      "id": "PRESERVE-MARKDOWN-IMAGE-LINES",
      "severity": "hard",
      "requirement_type": "text",
      "stage": "final",
      "source_refs": [
        "SKILL.md#PRESERVE-MARKDOWN-IMAGE-LINES"
      ],
      "checker_ids": [
        "protected-markdown-gate"
      ],
      "case_ids": [
        "image-lines-preserved",
        "image-line-deleted",
        "image-lines-reordered",
        "image-line-partially-protected"
      ],
      "historical_failure_known": true
    },
    {
      "id": "SCENE-DECLARED-BEFORE-REWRITE",
      "severity": "hard",
      "requirement_type": "schema",
      "stage": "source",
      "source_refs": [
        "SKILL.md#SCENE-DECLARED-BEFORE-REWRITE"
      ],
      "checker_ids": [
        "de-ai-delivery-gate"
      ],
      "case_ids": [
        "delivery-all-pass",
        "scene-not-declared-mutation",
        "scene-not-declared"
      ],
      "historical_failure_known": true
    },
    {
      "id": "PROTECTED-SPANS-PRESERVED",
      "severity": "hard",
      "requirement_type": "text",
      "stage": "final",
      "source_refs": [
        "SKILL.md#PROTECTED-SPANS-PRESERVED"
      ],
      "checker_ids": [
        "de-ai-delivery-gate"
      ],
      "case_ids": [
        "delivery-all-pass",
        "protected-span-mutated-mutation",
        "protected-span-mutated"
      ],
      "historical_failure_known": true
    },
    {
      "id": "QUALITY-SCORE-GATE-PASSED",
      "severity": "hard",
      "requirement_type": "schema",
      "stage": "final",
      "source_refs": [
        "SKILL.md#QUALITY-SCORE-GATE-PASSED"
      ],
      "checker_ids": [
        "de-ai-delivery-gate"
      ],
      "case_ids": [
        "delivery-all-pass",
        "quality-score-below-threshold-mutation",
        "quality-score-below-threshold"
      ],
      "historical_failure_known": true
    }
  ],
  "cases": [
    {
      "id": "image-lines-preserved",
      "kind": "positive",
      "constraint_ids": [
        "PRESERVE-MARKDOWN-IMAGE-LINES"
      ],
      "checker_ids": [
        "protected-markdown-gate"
      ],
      "artifacts": [
        {
          "artifact_id": "source-markdown",
          "path": "assets/stability/image-lines-source.md"
        },
        {
          "artifact_id": "final-markdown",
          "path": "assets/stability/image-lines-final-ok.md"
        }
      ],
      "expected": "pass",
      "expected_exit_code": 0
    },
    {
      "id": "image-line-deleted",
      "kind": "mutation",
      "constraint_ids": [
        "PRESERVE-MARKDOWN-IMAGE-LINES"
      ],
      "checker_ids": [
        "protected-markdown-gate"
      ],
      "artifacts": [
        {
          "artifact_id": "source-markdown",
          "path": "assets/stability/image-lines-source.md"
        },
        {
          "artifact_id": "final-markdown",
          "path": "assets/stability/image-lines-final-missing.md"
        }
      ],
      "expected": "blocked",
      "expected_exit_code": 3
    },
    {
      "id": "image-lines-reordered",
      "kind": "mutation",
      "constraint_ids": [
        "PRESERVE-MARKDOWN-IMAGE-LINES"
      ],
      "checker_ids": [
        "protected-markdown-gate"
      ],
      "artifacts": [
        {
          "artifact_id": "source-markdown",
          "path": "assets/stability/image-lines-source.md"
        },
        {
          "artifact_id": "final-markdown",
          "path": "assets/stability/image-lines-final-reordered.md"
        }
      ],
      "expected": "blocked",
      "expected_exit_code": 3
    },
    {
      "id": "image-line-partially-protected",
      "kind": "historical",
      "constraint_ids": [
        "PRESERVE-MARKDOWN-IMAGE-LINES"
      ],
      "checker_ids": [
        "protected-markdown-gate"
      ],
      "artifacts": [
        {
          "artifact_id": "source-markdown",
          "path": "assets/stability/image-lines-source.md"
        },
        {
          "artifact_id": "final-markdown",
          "path": "assets/stability/image-lines-final-mutated.md"
        }
      ],
      "expected": "blocked",
      "expected_exit_code": 3
    },
    {
      "id": "delivery-all-pass",
      "kind": "positive",
      "constraint_ids": [
        "SCENE-DECLARED-BEFORE-REWRITE",
        "PROTECTED-SPANS-PRESERVED",
        "QUALITY-SCORE-GATE-PASSED"
      ],
      "checker_ids": [
        "de-ai-delivery-gate"
      ],
      "artifacts": [
        {
          "artifact_id": "source-markdown",
          "path": "assets/stability/delivery-source.md"
        },
        {
          "artifact_id": "final-markdown",
          "path": "assets/stability/delivery-final-ok.md"
        },
        {
          "artifact_id": "run-plan",
          "path": "assets/stability/delivery-run-plan.json"
        },
        {
          "artifact_id": "score-receipt",
          "path": "assets/stability/delivery-score-good.json"
        }
      ],
      "expected": "pass",
      "expected_exit_code": 0
    },
    {
      "id": "scene-not-declared-mutation",
      "kind": "mutation",
      "constraint_ids": [
        "SCENE-DECLARED-BEFORE-REWRITE"
