      ],
      "artifacts": [
        {
          "artifact_id": "source-markdown",
          "path": "assets/stability/delivery-source.md"
        },
        {
          "artifact_id": "final-markdown",
          "path": "assets/stability/delivery-final-ok.md"
        },
        {
          "artifact_id": "run-plan",
          "path": "assets/stability/delivery-run-plan-invalid-scene.json"
