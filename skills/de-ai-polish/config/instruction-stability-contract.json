        {
          "artifact_id": "score-receipt",
          "path": "assets/stability/delivery-score-bad.json"
        }
      ],
      "expected": "blocked",
      "expected_exit_code": 3
    }
  ],
  "stability": {
    "minimum_runs": 3,
    "measurements": [
      {
        "id": "images-preserved",
        "checker_id": "protected-markdown-gate",
        "constraint_id": "PRESERVE-MARKDOWN-IMAGE-LINES",
        "value_type": "boolean",
        "condition": "equals",
        "expected": true
      },
      {
        "id": "scene-declared",
        "checker_id": "de-ai-delivery-gate",
        "constraint_id": "SCENE-DECLARED-BEFORE-REWRITE",
        "value_type": "boolean",
        "condition": "equals",
        "expected": true
      },
      {
        "id": "protected-spans-preserved",
        "checker_id": "de-ai-delivery-gate",
        "constraint_id": "PROTECTED-SPANS-PRESERVED",
        "value_type": "boolean",
        "condition": "equals",
        "expected": true
      },
      {
        "id": "failed-span-count",
        "checker_id": "de-ai-delivery-gate",
        "constraint_id": "PROTECTED-SPANS-PRESERVED",
        "value_type": "integer",
        "condition": "equals",
        "expected": 0
      },
      {
        "id": "score-gate-passed",
        "checker_id": "de-ai-delivery-gate",
        "constraint_id": "QUALITY-SCORE-GATE-PASSED",
        "value_type": "boolean",
        "condition": "equals",
        "expected": true
      }
    ],
    "observables": [
      {
        "id": "scene",
        "checker_id": "de-ai-delivery-gate",
        "constraint_ids": [
          "SCENE-DECLARED-BEFORE-REWRITE"
        ],
        "comparison": "set_equal",
        "required": true,
        "tolerance": null
      },
      {
        "id": "protected-image-lines",
        "checker_id": "protected-markdown-gate",
        "constraint_ids": [
          "PRESERVE-MARKDOWN-IMAGE-LINES"
        ],
        "comparison": "set_equal",
        "required": true,
        "tolerance": null
      },
      {
        "id": "protected-span-ids",
        "checker_id": "de-ai-delivery-gate",
        "constraint_ids": [
          "PROTECTED-SPANS-PRESERVED"
        ],
        "comparison": "set_equal",
        "required": true,
