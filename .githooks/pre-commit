#!/usr/bin/env bash
# 隐私守门 pre-commit 钩子（版本化，随仓库分发）
# 作用：拦截向公开仓库提交真实个人信息 / 案件信息
#   1) 结构化硬拦截：手机号 / 18 位身份证 / 座机 / 本机绝对路径 / 真实法院案号
#      （法院案号示例请用 (2026)苏XXXX民初XXXX号 占位形式，不会被拦截）
#   2) 本地黑名单：.githooks/local-denylist（一行一个词，# 开头为注释）
#      该文件通过 .git/info/exclude 排除，本地维护、绝不入库——黑名单放公开仓库等于二次泄露
# 逃生口：git commit --no-verify（仅限确认内容确属虚构时使用）
# 启用：git config core.hooksPath .githooks（克隆后执行一次）
set -uo pipefail

DIFF=$(git diff --cached --unified=0 --diff-filter=ACMR | grep '^+' | grep -v '^+++' || true)
[ -z "$DIFF" ] && exit 0

fail() {
  echo "❌ 隐私守门：检测到疑似真实信息，提交已拦截" >&2
  echo "   命中：$1" >&2
  echo "   处理：改用虚构示例；新增敏感词写入 .githooks/local-denylist（本地文件）" >&2
  echo "   确认虚构后可 git commit --no-verify 绕过" >&2
  exit 1
}

echo "$DIFF" | grep -nE '[[:<:]]1[3-9][0-9]{9}[[:>:]]'        >/dev/null && fail "手机号"
echo "$DIFF" | grep -nE '[[:<:]][0-9]{17}[0-9Xx][[:>:]]'      >/dev/null && fail "身份证号（18 位）"
echo "$DIFF" | grep -nE '[[:<:]]0[0-9]{2,3}-[0-9]{7,8}[[:>:]]' >/dev/null && fail "座机号码"
echo "$DIFF" | grep -nE '/Users/[a-zA-Z]+'                     >/dev/null && fail "本机绝对路径"
echo "$DIFF" | grep -nE '[（(][0-9]{4}[）)][^（）()]{0,8}(民初|刑初|行初|民终|民申|执|破)[0-9]+号' >/dev/null \
  && fail "真实法院案号（示例请用 (2026)苏XXXX民初XXXX号 占位形式）"

DENYLIST="$(dirname "$0")/local-denylist"
if [ -f "$DENYLIST" ]; then
  while IFS= read -r word; do
    [ -z "$word" ] && continue
    case "$word" in \#*) continue ;; esac
    echo "$DIFF" | grep -qF -- "$word" && fail "本地黑名单命中：$word"
  done < "$DENYLIST"
fi

exit 0
